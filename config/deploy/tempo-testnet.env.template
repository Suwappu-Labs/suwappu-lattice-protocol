# Tempo testnet ("moderato") deploy leg — copy to tempo-testnet.env and fill in.
# NEVER commit the filled copy; it contains private keys.
#
# Tempo is a payments-first L1 (Stripe / Paradigm), EVM-compatible, Osaka target.
# Read docs/design-decisions/TEMPO_INTEGRATION.md before deploying — this chain
# has two behaviours that break normal deploy tooling:
#
#   1. eth_getBalance returns a sentinel (0x4242…) for EVERY address, including
#      the zero address. It does not reflect spendable balance. eth_estimateGas
#      does not enforce a balance check either, so both cheap pre-flight checks
#      pass for an account that cannot pay; the failure surfaces at broadcast.
#      deploy_testnet_leg.sh warns about this but cannot verify spendability.
#
#   2. Native value transfers are rejected outright ("value transfer not
#      allowed") — value moves as TIP-20 stablecoins. register_signer_leg.sh
#      funds the operator with a native transfer, so that step must be done
#      through Tempo's own wallet/faucet instead.
#
# Fund the deployer via https://wallet.tempo.xyz or the Tempo CLI
# (`tempo wallet login && tempo wallet fund`) — the faucet is passkey-gated.

CHAIN_LABEL=tempo_testnet
CHAIN_ID=42431
RPC_URL=https://rpc.testnet.tempo.xyz
EXPLORER_URL=https://explore.tempo.xyz

# Multisig owner 1 — funded deployer EOA
DEPLOYER_PRIVATE_KEY=0x_FILL_ME

# Multisig owner 2 — operator wallet ADDRESS (key not needed for deploy)
SUWAPPU_OPERATOR_ADDRESS=0x_FILL_ME

# Bridge parameters (testnet defaults)
BRIDGE_CHALLENGE_PERIOD=3600
BRIDGE_MIN_OPERATOR_BOND=0
BRIDGE_MIN_CHALLENGER_BOND=0
BRIDGE_ZK_MODE=0

# Signer registration (scripts/register_signer_leg.sh)
SIGNER_VK_HASH=0x4212a67b46dd5fea793af0b980911ab6656313eb2ffb7d68b858187464ed2541
OPERATOR_PRIVATE_KEY=0x_FILL_ME
