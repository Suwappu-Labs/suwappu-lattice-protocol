# ETP Mainnet Environment Variables
#
# TURNKEY: Fill in REPLACE_* values and source this file for mainnet deployment.
# Equivalent to config/mainnet.toml but for containerized/K8s deployments.

# --- Node Identity ---
ETP_NODE_ID=REPLACE_NODE_ID
ETP_REGION=REPLACE_REGION

# --- Crypto (MANDATORY) ---
ETP_REQUIRE_REAL_CRYPTO=true

# --- Storage ---
ETP_STORAGE_BACKEND=sqlite
ETP_STORAGE_PATH=/data/etp

# --- Server ---
ETP_MAX_WORKERS=30
ETP_LOG_LEVEL=WARN
ETP_AUDIT_INTERVAL=30.0
ETP_DIAGNOSTICS_PUBLIC_MODE=true

# --- Anchor (on-chain) ---
ETP_ANCHOR_ENABLED=true
ETP_ANCHOR_RPC_URL=REPLACE_MAINNET_RPC_URL
ETP_ANCHOR_REGISTRY=REPLACE_MAINNET_REGISTRY
ETP_ANCHOR_OPERATOR_KEY=REPLACE_OPERATOR_KEY
ETP_ANCHOR_CHAIN_ID=REPLACE_CHAIN_ID
ETP_ANCHOR_BATCH_SIZE=100
ETP_ANCHOR_INTERVAL=60.0
ETP_ANCHOR_CONFIRMATION_DEPTH=12
ETP_ANCHOR_FINALITY_DEPTH=3

# --- Gateway (REST API) ---
ETP_GATEWAY_ENABLED=true
ETP_GATEWAY_PORT=8080
ETP_GATEWAY_JWT_ENABLED=true
ETP_GATEWAY_JWT_TTL=3600
ETP_GATEWAY_RATE_LIMIT=30

# --- TLS / mTLS (MANDATORY for production) ---
ETP_TLS_ENABLED=true
ETP_TLS_CERT_PATH=REPLACE_CERT_PATH
ETP_TLS_KEY_PATH=REPLACE_KEY_PATH
ETP_TLS_CA_PATH=REPLACE_CA_PATH
ETP_TLS_REQUIRE_CLIENT_CERT=true

# --- Gossip ---
ETP_GOSSIP_ENABLED=true
ETP_GOSSIP_INTERVAL=30.0
ETP_GOSSIP_MAX_PEERS=50
ETP_GOSSIP_LIVENESS_TIMEOUT=90.0

# --- Bridge Operator ---
ETP_BRIDGE_OPERATOR_ENABLED=true
ETP_BRIDGE_OPERATOR_INTERVAL=30.0
ETP_BRIDGE_OPERATOR_DIRECTION=REPLACE_BRIDGE_DIRECTION
ETP_BRIDGE_OPERATOR_MAX_RETRIES=3
ETP_BRIDGE_OPERATOR_CHALLENGE_PERIOD=604800.0
ETP_BRIDGE_OPERATOR_ZK_MODE=stark

# --- KMS (AWS) ---
ETP_KMS_BACKEND=aws
ETP_KMS_REGION=REPLACE_AWS_REGION
ETP_KMS_KEY_ARN=REPLACE_KMS_KEY_ARN

# --- Governance ---
ETP_GOVERNANCE_CONTRACT=REPLACE_GOVERNANCE_CONTRACT
ETP_GOVERNANCE_RPC=REPLACE_GOVERNANCE_RPC
ETP_GOVERNANCE_CHAIN_ID=REPLACE_CHAIN_ID

# --- Observability ---
ETP_OBSERVABILITY_ENABLED=true

