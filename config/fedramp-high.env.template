# LTP FedRAMP High readiness profile
#
# Copy to the deployment secret store or gateway env file and replace every
# REPLACE_* value. Do not commit filled secret values.

ETP_DEPLOYMENT_PROFILE=fedramp-high
ETP_REQUIRE_REAL_CRYPTO=true

# Gateway VM chain endpoints. FedRAMP High preflight rejects local, devnet,
# testnet, placeholder, and known public test-chain IDs.
ETP_GATEWAY_VM_SOURCE_CHAIN_ID=REPLACE_PRODUCTION_SOURCE_CHAIN_ID
ETP_GATEWAY_VM_SOURCE_RPC_URL=https://REPLACE_PRODUCTION_SOURCE_RPC
ETP_GATEWAY_VM_SOURCE_BRIDGE_CONTRACT=0xREPLACE_SOURCE_BRIDGE_CONTRACT
ETP_GATEWAY_VM_DEST_CHAIN_ID=REPLACE_PRODUCTION_DEST_CHAIN_ID
ETP_GATEWAY_VM_DEST_RPC_URL=https://REPLACE_PRODUCTION_DEST_RPC
ETP_GATEWAY_VM_DEST_REGISTRY=0xREPLACE_DEST_REGISTRY_CONTRACT

# No plaintext operator key is permitted in this profile.
# ETP_GATEWAY_VM_OPERATOR_KEY must remain unset.
ETP_GATEWAY_VM_OPERATOR_KMS_KEY_ID=REPLACE_GATEWAY_SIGNING_KEY_ID

# KMS/HSM boundary. AWS KMS envelope encryption is supported by this repo;
# hardware-backed signing evidence must identify the FIPS 140-3 module.
ETP_KMS_BACKEND=aws
ETP_KMS_REGION=us-gov-west-1
ETP_KMS_KEY_ARN=REPLACE_KMS_KEY_ARN
ETP_KMS_ENDPOINT=

# mTLS boundary for all operator-to-operator channels.
ETP_TLS_ENABLED=true
ETP_TLS_REQUIRE_CLIENT_CERT=true
ETP_TLS_CERT_PATH=/etc/ltp/tls/tls.crt
ETP_TLS_KEY_PATH=/etc/ltp/tls/tls.key
ETP_TLS_CA_PATH=/etc/ltp/tls/ca.crt

# Real bridge/prover mode. Do not use mock, simulated, disabled, dev, or test.
ETP_BRIDGE_OPERATOR_ZK_MODE=stark
ETP_GATEWAY_VM_CHALLENGE_MODE=optimistic

# Audit export. This must point at the authorized SIEM or audit collection sink.
ETP_SIEM_EXPORT_URL=https://REPLACE_SIEM_INGEST_ENDPOINT
