# LTP live legs — runtime configuration
#
# Copy to .env (or contracts/.env for scripts/bridge_live.py) and fill in the
# operator keys. NEVER commit the filled copy — it contains private keys.
#
# Addresses below are the live deployments recorded in
# docs/DEPLOYED_CONTRACTS.md. Both legs run LTPAnchorRegistry v6 behind a UUPS
# proxy, admin held by that leg's TimelockController.
#
# Variable naming follows the <PREFIX>_ scheme that scripts/bridge_live.py
# expects, so a leg pair can be selected with:
#   python scripts/bridge_live.py --l1-prefix ETHEREUM_SEPOLIA --l2-prefix BASE_SEPOLIA

# --- Base Sepolia (chain 84532) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_ANCHOR_REGISTRY=0x79eF1B7914f98C5C1404617449AB1f377c475996
BASE_SEPOLIA_OPERATOR_KEY=0x_YOUR_PRIVATE_KEY_HERE

# --- Ethereum Sepolia (chain 11155111) ---
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_SEPOLIA_CHAIN_ID=11155111
ETHEREUM_SEPOLIA_ANCHOR_REGISTRY=0xfd66b836cbe118001156c006e05cfe4432733cd3
ETHEREUM_SEPOLIA_OPERATOR_KEY=0x_YOUR_PRIVATE_KEY_HERE

# --- Bridge operator signer ---
# The ML-DSA-65 vkHash registered on BOTH legs. The corresponding secret key is
# NOT in this repo; scripts/bridge_live.py needs it as a keypair JSON to run the
# full signed path (see docs/OPERATOR_RUNBOOK.md).
BRIDGE_OPERATOR_VK_HASH=0x4212a67b46dd5fea793af0b980911ab6656313eb2ffb7d68b858187464ed2541

# --- Reminder on trust posture ---
# Both legs are pre-v7: 2-of-2 MultiSig, 60s Timelock, MODE_SIMULATED ZK
# verifier. Finality comes from the optimistic path only. Testnet only — do not
# move value. See docs/BRIDGE_TRUST_MODEL.md.
