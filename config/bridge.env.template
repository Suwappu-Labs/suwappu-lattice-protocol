# ETP Bridge Operator — Environment Variable Reference
# Copy to .env and customize for your bridge deployment.

# Bridge operator
ETP_BRIDGE_OPERATOR_ENABLED=true
ETP_BRIDGE_OPERATOR_INTERVAL=30.0
ETP_BRIDGE_OPERATOR_DIRECTION=suwappu_to_base
ETP_BRIDGE_OPERATOR_MAX_RETRIES=3
ETP_BRIDGE_OPERATOR_CHALLENGE_PERIOD=3600.0
ETP_BRIDGE_OPERATOR_ZK_MODE=simulated

# Gateway (recommended for bridge monitoring)
ETP_GATEWAY_ENABLED=true
ETP_GATEWAY_PORT=8080
ETP_GATEWAY_JWT_ENABLED=true
ETP_GATEWAY_JWT_TTL=3600
ETP_GATEWAY_RATE_LIMIT=60

# TLS (recommended for production)
ETP_TLS_ENABLED=false
ETP_TLS_CERT_PATH=/certs/server.pem
ETP_TLS_KEY_PATH=/certs/server.key
ETP_TLS_CA_PATH=/certs/ca.pem
ETP_TLS_REQUIRE_CLIENT_CERT=true

# Gossip (recommended for multi-node)
ETP_GOSSIP_ENABLED=true
ETP_GOSSIP_INTERVAL=30.0
ETP_GOSSIP_MAX_PEERS=20
ETP_GOSSIP_LIVENESS_TIMEOUT=90.0

# Anchor chains (required for bridge)
ETP_ANCHOR_ENABLED=true
ETP_ANCHOR_RPC_URL=http://localhost:8545
ETP_ANCHOR_REGISTRY=0xYOUR_REGISTRY_ADDRESS
ETP_ANCHOR_OPERATOR_KEY=0xYOUR_OPERATOR_KEY
ETP_ANCHOR_CHAIN_ID=103115120
