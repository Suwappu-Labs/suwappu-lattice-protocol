!.env.*.example
!.env.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Claude Code
# `.claude/*` rather than `.claude/` because git cannot re-include a file whose
# parent directory is excluded, and two files here are shared infrastructure
# rather than private notes: the SessionStart hook that provisions a remote
# container (without it `pytest tests/` aborts during collection and the lint
# lane silently skips), and the settings that register it. Everything else
# under .claude/ stays ignored, which is what this rule was always for.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
# Project-level CLAUDE.md is tracked (Anthropic-recommended pattern, see
# docs/AI_AGENTS.md). Keep private session notes under .claude/ instead.
docs/ETP_UNIFIED_NODE_DEPLOYMENT_PLAN.md
docs/ETP_IMPLEMENTATION_STATUS.md
docs/superpowers/

# Bridge execution outputs
bridge_results*.json

# Key material — never commit. (gateway_keypair.json was previously committed and
# is being rotated; broad patterns below so no keypair/key/cert slips in again.)
*keypair*.json
deploy/gateway_keypair.json
bridge_operator_keypair.json
*.key
*.pem

# Solidity / Foundry (contracts/)
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Rust / SP1 (zkvm/)
zkvm/*/target/

# Node
node_modules/

# Runtime data
rocksdb_shards/
rocksdb_shards

# Stale pip artifacts
=*

# Auto-generated pdoc API reference (regenerate via `make docs-api`)
docs/api/python/

# Lean build artifacts
.lake/
formal/lean/.lake/

# Filled per-chain deploy configs contain private keys — only templates are tracked
config/deploy/*.env

# lychee link-checker cache (lychee.toml sets cache = true, so the docs
# lane leaves this behind on every local run)
.lycheecache
