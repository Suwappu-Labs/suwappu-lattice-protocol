{
  "filter_paths": "lib/|test/|out/|script/",
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_medium": false,
  "exclude_high": false,
  "exclude_optimization": true,
  "disable_color": false,
  "solc_remaps": ["@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/"],
  "detectors_to_exclude": "pragma,solc-version,naming-convention,similar-names,assembly,too-many-digits"
}
