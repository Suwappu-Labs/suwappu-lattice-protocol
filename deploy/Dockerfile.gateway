# ETP Gateway VM — Multi-stage Docker Build
#
# Build: docker build -f deploy/Dockerfile.gateway -t etp-gateway .
# Run:   docker run --env-file deploy/.env.gateway etp-gateway
#
# Stage 1: Build dependencies (liboqs, pqcrypto, web3, grpcio)
# Stage 2: Runtime with production deps only

# ---------------------------------------------------------------------------
# Stage 1: Builder
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm@sha256:d193c6f51a7dbd10395d6328de3a7edb0516fb0608ca138036576f574c3e07d2 AS builder

WORKDIR /build

# System deps for building liboqs and grpcio
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (layer caching)
COPY pyproject.toml .
COPY src/ src/

# Install gateway + chain + production extras (production includes blake3, pqcrypto, pynacl)
RUN pip install --no-cache-dir ".[gateway,chain,production]"

# ---------------------------------------------------------------------------
# Stage 2: Runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm@sha256:d193c6f51a7dbd10395d6328de3a7edb0516fb0608ca138036576f574c3e07d2 AS runtime

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY src/ src/
COPY pyproject.toml .

# Security hardening
RUN useradd --create-home --shell /bin/bash etp \
    && chown -R etp:etp /app
USER etp

# Environment
ENV ETP_REQUIRE_REAL_CRYPTO=1
ENV PYTHONUNBUFFERED=1

# Expose API + metrics ports
EXPOSE 8000 9090

# Health check against the FastAPI /status endpoint
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/gateway/health')" || exit 1

ENTRYPOINT ["python", "-m", "ltp.gateway_vm"]
